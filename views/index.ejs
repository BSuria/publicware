<!doctype html>
<html lang="en">
<head>
    <title>CS4241 Assignment 2</title>
    <meta charset="utf-8">
    <script src="js/main.js"></script>
    <link rel="stylesheet" href="css/main.css">
    <link href="https://fonts.googleapis.com/css?family=Press+Start+2P" rel="stylesheet">
    <link href="https://unpkg.com/nes.css/css/nes.css" rel="stylesheet" />

    <!-- get rid of favicon error -->
    <link rel="icon" href="data:;base64,iVBORw0KGgo=">
</head>
<body>
<div class="nes-container">
    <form>
        <div style="overflow: hidden;" class="nes-container is-rounded is-dark">
            <h1 style="float: left;">Playtime Leaderboard</h1>
            <button style="float: right;" id="signoutbutton" type="submit" class="nes-btn is-error">Sign Out</button>
        </div>
        <br/>
        <section>
            <div class="nes-container is-dark with-title">
                <h1 class="title">What is this?</h1>
                <p>This website will compare your how much time you've spent playing a game to other users.</p>
            </div>
            <br/>
        </section>
        <section class="nes-container is-rounded">
            <h2>Game Information</h2>
            <p>
                <label for="gamename">
                    What is your most played game?
                </label><br>
                <input type="text" id="gamename" name="most-played-game" placeholder="Game Name" required/>
            </p>
            <p>
                <label for="playtime">
                    How many hours do you have in this game?
                </label><br>
                <input type="number" id="playtime" name="play-time" placeholder="Total Playtime"/>
            </p>
            <p>
                <label for="startdate">
                    When did you start playing this game?
                </label><br>
                <input type="text" id="startdate" name="started-playing" placeholder="MM/DD/YY"
                       pattern="^(0[1-9]|1[0-2])\/(0[1-9]|[12][0-9]|3[01])\/(20[0-9]{2})$" required/>
            </p>
            <br>
            <p>
                <button id="submitbutton" type="submit" class="nes-btn is-primary">Submit</button>
            </p>
        </section>

        <h2 id ="resultsHeader">Here are your Results</h2>
        <p id="results"></p>
    </form>
    <form>
        <aside class="nes-container with-title">
            <h1 class="title">Everybody's Playtime</h1>
            <p>
                <table class="nes-table is-bordered is-centered" id="datatable">
                    <thead>
                    <tr>
                        <th>Actions</th>
                        <th>Name</th>
                        <th>Game Name</th>
                        <th>Playtime</th>
                        <th>Start Date</th>
                        <th>Hours/Day</th>
                    </tr>
                    </thead>
                    <tbody>
                    <%- emptytable || '' %>
                    </tbody>
                </table>
            </p>
        </aside>
    </form>
</div>

</body>
</html>
